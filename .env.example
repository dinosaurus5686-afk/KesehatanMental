# Domain publik (dipakai Caddy untuk HTTPS otomatis di docker-compose.prod.yml)
DOMAIN=pan-jalu.com
# Port HTTP aplikasi
PORT=3000
# Kunci enkripsi kolom sensitif (64 karakter hex = 32 byte). WAJIB diset & disimpan aman di produksi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MC_DATA_KEY=
# Kunci penandatangan JWT (64 karakter hex)
MC_JWT_SECRET=
# Lokasi basis data & berkas unggahan
MC_DATA_DIR=./data
# 1 = isi akun & data contoh saat basis data kosong; 0 = hanya data referensi (produksi)
MC_DEMO=1
# Akun admin pertama untuk produksi (MC_DEMO=0). Dibuat otomatis saat server pertama kali jalan bila belum ada admin.
MC_ADMIN_EMAIL=
MC_ADMIN_PASSWORD=
# 1 bila berjalan di belakang reverse proxy (Nginx) agar IP & HTTPS terbaca benar
MC_TRUST_PROXY=0
# Alamat publik aplikasi (dipakai di tautan email verifikasi & reset kata sandi)
MC_APP_URL=https://pan-jalu.com
# SMTP untuk mengirim email verifikasi (WAJIB di produksi; tanpa ini email hanya disimpan di data/outbox)
MC_SMTP_HOST=smtp.hostinger.com
MC_SMTP_PORT=465
MC_SMTP_SECURE=1
MC_SMTP_USER=no-reply@pan-jalu.com
MC_SMTP_PASS=
MC_MAIL_FROM=PAN-JALU <no-reply@pan-jalu.com>
# 1 = tolak email yang domainnya tidak punya server email (MX). Matikan (0) hanya untuk pengujian lokal tanpa DNS.
MC_EMAIL_MX_CHECK=1
# Opsional: aktifkan AI Insight Service dengan model bahasa (tanpa ini, generator berbasis aturan dipakai)
ANTHROPIC_API_KEY=
MC_AI_MODEL=claude-opus-5-5
